{
  "name": "theme-lens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:local": "npm install && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "dev": "concurrently -k -n next,python -c cyan,magenta \"npm run dev:next\" \"npm run dev:python\"",
    "dev:next": "next dev",
    "dev:python": ".venv/bin/python -m uvicorn api.python_analyze:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "density-clustering": "^1.3.0",
    "lucide-react": "^1.7.0",
    "ml-kmeans": "^7.0.0",
    "ml-pca": "^4.1.1",
    "next": "16.2.1",
    "openai": "^6.33.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "concurrently": "^9.2.0",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
